# ============================================================
# TEMPLATE - copy to .env and fill in.
# NEVER commit real secrets. .env is gitignored; this file is not.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://your-app.vercel.app"

# --- Google OAuth ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments: MOCK | XENDIT ---
PAYMENT_PROVIDER="XENDIT"
# dashboard.xendit.co -> Settings -> Developers -> API Keys (use a SECRET key)
XENDIT_SECRET_KEY=""
# dashboard.xendit.co -> Settings -> Developers -> Webhooks -> verification token
# Webhook URL to register: <BETTER_AUTH_URL>/api/webhooks/xendit
XENDIT_CALLBACK_TOKEN=""

# --- Email: CONSOLE | RESEND ---
EMAIL_PROVIDER="RESEND"
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# --- Uploads: LOCAL | BLOB ---
UPLOAD_PROVIDER="BLOB"
BLOB_READ_WRITE_TOKEN=""
